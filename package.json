{
  "name": "bbc-club",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/modules/*",
    "packages/modules/*/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "arch:check": "depcruise --config .dependency-cruiser.cjs --output-type err-long apps packages",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps packages --exclude 'node_modules|test' | dot -T svg > docs/architecture/modules.svg",
    "tokens": "bun run scripts/tokens.ts",
    "tokens:check": "bun run scripts/tokens.ts --check",
    "design:lint": "npx -y @google/design.md lint DESIGN.md",
    "module:check": "bun run scripts/check-modules.ts",
    "new-module": "bun run scripts/new-module.ts",
    "test:unit": "turbo run test:unit",
    "test:db": "docker compose -f infra/compose.test.yml up -d --wait && turbo run test:db",
    "db:verify": "bun run --filter @bbc/db db:verify",
    "validate:quick": "bun run format && bun run lint && bun run arch:check && bun run typecheck && bun run tokens:check && bun run design:lint && bun run module:check",
    "validate": "bun run validate:quick && bun run test:unit && bun run test:db && bun run db:verify",
    "e2e": "maestro test apps/mobile/e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "bun-types": "1.3.4",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.20.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.25.0",
    "yaml": "^2.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings 0"
  }
}
