# Staging runs on the production box as extra services. Disposable: no backups, sandbox providers.
# Every comment on its own line: Compose reads "KEY=   # comment" as the value "# comment".
# Only staging's own settings: a key production's services also read (INTERNAL_API_SECRET, MINIO_USER, MINIO_PASSWORD,
# REDIS_APP_PASSWORD, Caddy's settings) would reach them with staging's value, so deploy.sh and bootstrap.sh refuse it.
NODE_ENV=production
LOG_LEVEL=debug
# deploy.sh writes a SHA tag; never :staging
API_IMAGE_STAGING=ghcr.io/nasalciuc/bbc-api:REPLACE_WITH_SHA
# openssl rand -hex 32 — different from production; hex only (connection URLs)
POSTGRES_PASSWORD_STAGING=
# Policy flags are rows in platform.flags, seeded by scripts/seed-flags.ts (ADR-PROD-001).
# members.allow_non_crm_signups is seeded { "enabled": false } — an unknown CRM email goes to the waitlist.
# different from production
BETTER_AUTH_SECRET=
APP_ORIGIN=https://api-staging.buybusinessclass.com
MOBILE_SCHEME=bbcclub
# openssl rand -base64 48 — compose.staging.yml hands it to staging's API, worker and cron as INTERNAL_API_SECRET
INTERNAL_API_SECRET_STAGING=
# Postmark's sandbox stream. Required: staging runs with NODE_ENV=production, which does not start without a token.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=club@buybusinessclass.com
PUSH_ADAPTER=recording
# from Apple Developer → Keys; base64 of the .p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.buybusinessclass.club
APNS_P8_BASE64=
APNS_ENVIRONMENT=sandbox
FCM_SERVICE_ACCOUNT_BASE64=
# ADR-PROD-001: unknown CRM email is waitlist, never active. The flag row is seeded false by
# scripts/seed-flags.ts; this line documents the intent for operators.
MEMBERS_ALLOW_NON_CRM_SIGNUPS=false
CRM_ADAPTER=mock
# Both required when CRM_ADAPTER=email; OPS_LINK_SECRET has at least 32 characters. Without it, every operator link
# is refused (ADR-IMPL-047): no link can be signed with an empty secret.
# OPERATORS_EMAIL=ops@buybusinessclass.com
# OPS_LINK_SECRET=
# Both required when CRM_ADAPTER=http (ADR-IMPL-065): the CRM's public https address for requests (staging runs as
# production: a loopback, private or link-local one is refused), and the signing secret shared with the CRM team (at
# least 32 characters; the HMAC key is its text as UTF-8, never decoded). Live mobile endpoint (ADR-IMPL-065):
# CRM_API_URL=https://webapi.buybusinessclass.com/requests/mobile
# CRM_API_SECRET=
# Optional (ADR-IMPL-043); production's key would share its hourly limit.
# PEXELS_API_KEY=
REVIEW_ACCOUNT_EMAIL=review@buybusinessclass.com
REVIEW_ACCOUNT_PASSWORD=
