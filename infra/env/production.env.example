# cp → production.env · chmod 600 · root · NEVER commit. bootstrap.sh checks the required keys.
# Every comment on its own line: Compose reads "KEY=   # comment" as the value "# comment".
NODE_ENV=production
LOG_LEVEL=info
API_DOMAIN=api.buybusinessclass.com
API_DOMAIN_STAGING=api-staging.buybusinessclass.com
ACME_EMAIL=ops@buybusinessclass.com
# deploy.sh rewrites both with a SHA tag; API_IMAGE_STAGING is required when the staging overlay is attached.
API_IMAGE=ghcr.io/nasalciuc/bbc-api:REPLACE_WITH_SHA
API_IMAGE_STAGING=ghcr.io/nasalciuc/bbc-api:REPLACE_WITH_SHA
# Two API replicas on two cores with staging alongside (docs/perf/CAPACITY.md); Compose and deploy.sh read the same value.
# API_REPLICAS=2
# API_REPLICAS_STAGING=2
# Memory limits: the budget for the 8 GB box is at the top of docker-compose.yml. Move one only with that sum in view.
# API_MEMORY=512m
# WORKER_MEMORY=512m
# POSTGRES_MEMORY=2g

# ── the certificate between Cloudflare and this box (RUNBOOK § Certificates) ──
# on: Caddy serves the Cloudflare Origin CA certificate, ORIGIN_CERT_DIR/cert.pem and key.pem, and asks no CA for one.
# off: Caddy gets its own certificates, as before. Caddy reads this value as written: keep any comment on its own line.
ORIGIN_TLS=off
# ORIGIN_CERT_DIR=/etc/bbc/origin

# ── database ──────────────────────────────────────────────────────────────
# openssl rand -hex 32 — goes into connection URLs: hex only
POSTGRES_PASSWORD=

# Policy flags are rows in platform.flags, seeded by scripts/seed-flags.ts (ADR-PROD-001).
# members.allow_non_crm_signups is seeded { "enabled": false } — an unknown CRM email goes to the waitlist.
# ── auth ──────────────────────────────────────────────────────────────────
# openssl rand -base64 48 · rotation invalidates all sessions
BETTER_AUTH_SECRET=
APP_ORIGIN=https://api.buybusinessclass.com
MOBILE_SCHEME=bbcclub
SESSION_COOKIE_CACHE_SECONDS=60

# ── service-to-service (CRM, marketing, cron) ─────────────────────────────
# openssl rand -base64 48. rotate-secret.sh writes INTERNAL_API_SECRET_NEXT during a rotation window.
INTERNAL_API_SECRET=

# ── email (Postmark stream dedicated to the app; no second provider) ──────
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=club@buybusinessclass.com

# ── push ──────────────────────────────────────────────────────────────────
# live: Android through Firebase. iPhone through APNs once the Apple account exists: APNS_KEY_ID, APNS_TEAM_ID and
# APNS_P8_BASE64 together, or none of them; until then an iPhone notification is marked failed. recording: nothing is sent.
PUSH_ADAPTER=recording
# base64 -w0 of the Firebase service-account JSON (Project settings → Service accounts)
FCM_SERVICE_ACCOUNT_BASE64=
# from Apple Developer → Keys; base64 of the .p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.buybusinessclass.club
APNS_P8_BASE64=
APNS_ENVIRONMENT=production

# ADR-PROD-001: unknown CRM email is waitlist, never active. The flag row is seeded false by
# scripts/seed-flags.ts; this line documents the intent for operators.
MEMBERS_ALLOW_NON_CRM_SIGNUPS=false

# ── CRM ───────────────────────────────────────────────────────────────────
# mock | email | http. http (ADR-IMPL-065) POSTs each request to the CRM, signed; the CRM sends a status back
# through POST /v1/internal/requests/:id/status. Not with INTERNAL_API_SECRET, which unlocks every system permission:
# the CRM needs a credential of its own first (ADR-IMPL-065, Left to the owner).
CRM_ADAPTER=email
# Both required when CRM_ADAPTER=email: the specialists' inbox, and openssl rand -base64 48 (at least 32 characters).
OPERATORS_EMAIL=
OPS_LINK_SECRET=
# Both required when CRM_ADAPTER=http: the CRM's public https address for requests (a loopback, private or link-local
# one is refused), and the signing secret shared with the CRM team (openssl rand -hex 32; at least 32 characters). The
# HMAC key is the secret's text as UTF-8, never decoded.
CRM_API_URL=
CRM_API_SECRET=

# ── media ─────────────────────────────────────────────────────────────────
MINIO_USER=bbc
MINIO_PASSWORD=

# ── errors: GlitchTip, off until I2 connects it (four containers, about 1.6 GB) ──
# on: bootstrap.sh and deploy.sh start it, and the three keys below must be filled in (bootstrap.sh checks).
GLITCHTIP=off
# GLITCHTIP_DB_PASSWORD: openssl rand -hex 32 — GlitchTip's own Postgres; hex only (a connection URL).
# GLITCHTIP_SECRET: openssl rand -base64 48.
# ERRORS_DOMAIN=errors.buybusinessclass.com
# GLITCHTIP_DB_PASSWORD=
# GLITCHTIP_SECRET=

# ── Redis / Kafka (ADR-IMPL-029, ADR-IMPL-030) ────────────────────────────
# redis-app will not start without this. Leave REDIS_URL and KAFKA_BROKERS unset until the runbook says to turn them on.
# openssl rand -hex 32
REDIS_APP_PASSWORD=
# REDIS_URL=redis://:PASSWORD@redis-app:6379
# KAFKA_BROKERS=kafka:9092

# ── place photos (ADR-IMPL-043) ───────────────────────────────────────────
# Optional: Pexels photos for cities Commons has none of (https://www.pexels.com/api/). Unset: Commons, then satellite.
# PEXELS_API_KEY=

# ── App Review demo member ────────────────────────────────────────────────
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_PASSWORD=

# ── backups (pgBackRest reads these natively; object storage OUTSIDE this box) ──
# e.g. fsn1.your-objectstorage.com
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=bbc-backups
PGBACKREST_REPO1_S3_REGION=eu-central
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# openssl rand -base64 48 — LOSE THIS AND THE BACKUPS ARE UNREADABLE. Password manager.
PGBACKREST_REPO1_CIPHER_PASS=

# ── alerts (Slack-compatible incoming webhooks; Telegram via a relay) ─────
OPS_WEBHOOK=
SEC_WEBHOOK=
