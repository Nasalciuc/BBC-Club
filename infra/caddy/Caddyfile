{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
		# Cloudflare sits in front on "Full (strict)". Without this, remote_host is Cloudflare's IP and
		# every per-IP rule (Better Auth rate limits, logs) would see Cloudflare instead of the client.
		import /etc/caddy/cloudflare_ranges.caddy
		# Without this, Caddy parses X-Forwarded-For left-to-right, so a spoofed leading 127.0.0.1
		# reaches the client_ip matcher and opens /metrics and /ready through Cloudflare.
		trusted_proxies_strict
	}
}

(api_site) {
	encode zstd gzip

	# operator-only endpoints: reachable through an SSH tunnel to the box, never from the internet
	@ops path /metrics /ready
	handle @ops {
		@remote not client_ip 127.0.0.1/32 ::1/128
		respond @remote 404
		reverse_proxy {
			dynamic a {
				name {args[0]}
				port 8000
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 5s
			fail_duration 10s
			max_fails 2
			unhealthy_status 5xx
		}
	}

	# associated-domain files (AASA / assetlinks) — the real ones live on buybusinessclass.com;
	# this route exists only if the site is served from this box too
	handle_path /.well-known/* {
		root * /srv/well-known
		file_server
	}

	# offer photography: public read-only bucket, cached by Cloudflare
	handle_path /media/* {
		reverse_proxy minio:9000 {
			header_up Host {upstream_hostport}
		}
		header Cache-Control "public, max-age=86400, immutable"
	}

	handle {
		reverse_proxy {
			dynamic a {
				name {args[0]}
				port 8000
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 5s
			fail_duration 10s
			max_fails 2
			unhealthy_status 5xx
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	log {
		output stdout
		format json
		level INFO
	}
}

{$API_DOMAIN} {
	import /etc/caddy/origin-pulls.caddy
	import api_site api
}

{$API_DOMAIN_STAGING} {
	import /etc/caddy/origin-pulls.caddy
	import api_site api-staging
}
