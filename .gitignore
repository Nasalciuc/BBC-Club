# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# ── secrets ───────────────────────────────────────────────────────────────────
# Every one of these has leaked from a repository somewhere. infra/env/*.env holds
# BETTER_AUTH_SECRET, POSTGRES_PASSWORD, Postmark and object-storage keys; it arrives at the
# repository root with the monorepo assembly, so the rule exists before the files do.
.env
.env.*
!.env.example
!*.env.example
infra/env/*.env
**/infra/env/*.env
*.dump
*.sql.gz

# ── regenerable artefacts (never committed; `graphify update` rebuilds them) ──
graphify-out/
**/graphify-out/

# ── package managers ─────────────────────────────────────────────────────────
# This project installs with Bun. An npm lockfile only creates merge conflicts.
package-lock.json
yarn.lock
pnpm-lock.yaml
