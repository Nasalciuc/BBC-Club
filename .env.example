# Local tooling only (not loaded by @bbc/api ServerEnv).
# Copy to `.env` at the repo root and fill in. `.env` is gitignored.

# Graphify semantic extraction / community labeling (optional).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alternative name graphify also accepts

# Optional model override for graphify (default is gemini-3-flash-preview).
# GRAPHIFY_GEMINI_MODEL=gemini-2.0-flash

# Compose interpolates this into redis-app (infra/docker-compose.yml). Not read by ServerEnv.
# REDIS_APP_PASSWORD=
