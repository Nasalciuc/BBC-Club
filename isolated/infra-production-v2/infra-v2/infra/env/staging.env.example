# Staging runs on the production box as extra services. Disposable: no backups, sandbox providers.
NODE_ENV=production
LOG_LEVEL=debug
API_IMAGE_STAGING=ghcr.io/nasalciuc/bbc-api:staging
POSTGRES_PASSWORD_STAGING=             # different from production
BETTER_AUTH_SECRET=                    # different from production
APP_ORIGIN=https://api-staging.buybusinessclass.com
MOBILE_SCHEME=bbcclub
INTERNAL_API_SECRET_STAGING=
INTERNAL_API_SECRET=${INTERNAL_API_SECRET_STAGING}
EMAIL_ADAPTER=postmark
POSTMARK_SERVER_TOKEN=                 # sandbox stream; empty = codes are logged, not sent
POSTMARK_FROM=club@buybusinessclass.com
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.buybusinessclass.club
APNS_P8_BASE64=
APNS_ENVIRONMENT=sandbox
FCM_SERVICE_ACCOUNT_BASE64=
CRM_ADAPTER=mock
MINIO_USER=bbc
MINIO_PASSWORD=
REVIEW_ACCOUNT_EMAIL=review@buybusinessclass.com
REVIEW_ACCOUNT_PASSWORD=
