# Installed to /etc/cron.d/bbc by bootstrap.sh. Runs on the HOST (needs docker). Times are UTC.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
APP_DIR=/opt/bbc
30 1 * * *   root  bash /opt/bbc/infra/host/backup.sh full   >> /var/log/bbc-backup.log 2>&1
0  */6 * * * root  bash /opt/bbc/infra/host/backup.sh diff   >> /var/log/bbc-backup.log 2>&1
0  6 1 * *   root  bash /opt/bbc/infra/restore-test.sh       >> /var/log/bbc-restore-test.log 2>&1
*/10 * * * * root  bash /opt/bbc/infra/host/disk-check.sh    >> /var/log/bbc-disk.log 2>&1
