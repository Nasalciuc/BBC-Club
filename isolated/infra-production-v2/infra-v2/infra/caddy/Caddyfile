{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
		# Cloudflare sits in front on "Full (strict)". Without this, remote_host is Cloudflare's IP and
		# every per-IP rule (Better Auth rate limits, logs) would see Cloudflare instead of the client.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		# Without this, Caddy parses X-Forwarded-For left-to-right, so a spoofed leading 127.0.0.1
		# reaches the client_ip matcher and opens /metrics and /ready through Cloudflare.
		trusted_proxies_strict
	}
}

(api_site) {
	encode zstd gzip

	# operator-only endpoints: reachable through an SSH tunnel to the box, never from the internet
	@ops path /metrics /ready
	handle @ops {
		@remote not client_ip 127.0.0.1/32 ::1/128
		respond @remote 404
		reverse_proxy {args[0]}
	}

	# associated-domain files (AASA / assetlinks) — the real ones live on buybusinessclass.com;
	# this route exists only if the site is served from this box too
	handle_path /.well-known/* {
		root * /srv/well-known
		file_server
	}

	# offer photography: public read-only bucket, cached by Cloudflare
	handle_path /media/* {
		reverse_proxy minio:9000 {
			header_up Host {upstream_hostport}
		}
		header Cache-Control "public, max-age=86400, immutable"
	}

	handle {
		reverse_proxy {args[0]} {
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	log {
		output stdout
		format json
		level INFO
	}
}

{$API_DOMAIN} {
	import api_site api:8000
}

{$API_DOMAIN_STAGING} {
	import api_site api-staging:8000
}
